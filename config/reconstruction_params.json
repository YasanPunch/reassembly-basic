{
  "// --- I. Preprocessing, Point Cloud Generation ---": null,
  "voxel_downsample_size": 3.0,
  "fracture_surface_dense_sample_points": 10000,
  "add_preprocessing_noise": true,
  "preprocessing_noise_factor": 0.01,

  "// --- Normal Estimation (for features PCD & fallbacks in alignment) ---": null,
  "normal_estimation_radius": 14.0,
  "normal_estimation_max_nn": 30,
  "orient_normals_k": 15,

  "// --- II. Segmentation (New Parameters based on Region Growing) ---": null,
  "visualize_segmentation": true,
  "// Enables interactive selection of segments from extract_fracture_surface_mesh": null,
  "max_curvature_deg": 30.0,
  "// Max angle (degrees) for region growing normal similarity (e.g., 20-45)": null,
  "area_limit_fraction": 0.02,
  "// Min area fraction for a region to survive cleanup (e.g., 0.01-0.05)": null,
  "use_geometric_detection": true,
  "// NEW: Enable automatic fracture detection using scale-invariant geometric features": null,
  "use_curvature_compensated_detection": true,
  "// Use curvature-compensated roughness detection (works correctly on curved surfaces)": null,
  "use_direct_roughness_detection": true,
  "// Use direct surface roughness measurements (fallback method, assumes flat surfaces)": null,
  "debug_fracture_detection": false,
  "// Enable detailed debugging output for fracture detection (shows feature analysis, voting, suggestions)": null,
  "interactive_debug": false,
  "// Enable interactive region-by-region analysis during debugging": null,

  "// --- III. Feature Extraction (FPFH) ---": null,
  "fpfh_feature_radius": 10.0,
  "fpfh_feature_max_nn": 100,

  "// --- IV. Alignment: RANSAC (Global Registration) ---": null,
  "ransac_distance_threshold_factor": 1.5,
  "ransac_edge_length_factor": 0.9,
  "ransac_iterations": 4000000,
  "ransac_n_points": 4,
  "ransac_confidence": 0.999,

  "// --- V. Alignment: ICP (Local Refinement) ---": null,
  "icp_max_correspondence_distance_factor": 2.0,
  "icp_relative_fitness": 1e-6,
  "icp_relative_rmse": 1e-6,
  "icp_max_iteration": 50,

  "// --- VI. Matching and Assembly ---": null,
  "min_match_score": 0.3,
  "// Minimum ICP fitness for a pairwise alignment to be considered valid": null,
  "max_assembly_overlap_factor_aabb": 0.95,
  "overlap_check_sample_points": 300,
  "overlap_penetration_allowance_ratio": 0.25,
  "overlap_penetration_depth_factor": 0.25,
  "debug_assembly": true,
  "disable_overlap_check": true
}
