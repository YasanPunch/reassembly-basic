{
    "// --- I. Preprocessing, Point Cloud Generation ---": null,
    "voxel_downsample_size": 3.0,
    "fracture_surface_dense_sample_points": 10000,
    "add_preprocessing_noise": true,
    "preprocessing_noise_factor": 0.01,

    "// --- Normal Estimation ---": null,
    "normal_estimation_radius": 14.0,
    "normal_estimation_max_nn": 30,
    "orient_normals_k": 15,

    "// --- II. Segmentation (Region Growing) ---": null,
    "visualize_segmentation": true,
    "max_angle_deviation_deg": 30.0,
    "min_region_area_percentage": 2.0,
    "fracture_roughness_threshold": 0.1,
    "min_final_segment_size_after_cleanup": 50,
    
    "// --- III. Feature Extraction (FPFH) ---": null,
    "fpfh_feature_radius": 10.0,
    "fpfh_feature_max_nn": 100,

    "// --- IV. Enhanced Alignment: RANSAC ---": null,
    "ransac_distance_threshold_factor": 1.5,
    "ransac_edge_length_factor": 0.9,
    "ransac_iterations": 4000000,
    "ransac_n_points": 4,
    "ransac_confidence": 0.999,
    "normal_angle_threshold": 0.523599,
    "min_ransac_fitness": 0.1,
    "min_ransac_fitness_threshold": 0.1,
    "max_derivative_error": 0.1,
    "derivative_sample_points": 1000,
    "derivative_distance_threshold": 3.0,

    "// --- V. Enhanced Alignment: ICP ---": null,
    "icp_max_correspondence_distance_factor": 2.0,
    "icp_relative_fitness": 1e-6,
    "icp_relative_rmse": 1e-6,
    "icp_max_iteration": 50,

    "// --- VI. Enhanced Matching ---": null,
    "min_match_score": 0.3,
    "min_enhanced_score": 0.1,
    "min_quality_score": 0.05,
    "use_material_axis_bias": false,
    "material_axis_weight": 0.1,
    "use_overlap_bias": true,
    "overlap_weight": 0.2,
    "rmse_scale": 0.01,
    "use_directional_constraints": false,
    "use_size_filtering": true,
    "max_size_ratio": 10.0,
    "num_workers": 4,
    "filter_overlapping_matches": true,
    "max_matches_per_fragment": 3,
    "overlap_grid_resolution": 50,

    "// --- VII. Enhanced Assembly ---": null,
    "max_assembly_overlap_factor_aabb": 0.95,
    "overlap_check_sample_points": 300,
    "overlap_penetration_allowance_ratio": 0.25,
    "overlap_penetration_depth_factor": 0.25,
    "use_mutual_visibility_check": true,
    "mutual_visibility_samples": 500,
    "min_mutual_visibility_ratio": 0.3,
    "seed_selection_strategy": "connectivity",
    
    "// --- VIII. Global Optimization ---": null,
    "use_simulated_annealing": true,
    "sa_max_iterations": 2000,
    "sa_equilibrium_iterations": 80,
    "use_pose_graph_optimization": true
}