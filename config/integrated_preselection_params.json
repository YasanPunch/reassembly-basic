{
  "// --- Integrated Automatic Pre-selection Parameters ---": null,
  "// This configuration enables automatic fracture surface detection": null,
  "// that pre-selects regions before interactive user selection": null,

  "// --- I. Basic Segmentation ---": null,
  "max_curvature_deg": 30.0,
  "area_limit_fraction": 0.02,
  "visualize_segmentation": true,
  "elevation_map_resolution": 64,

  "// --- II. Automatic Pre-selection (NEW) ---": null,
  "use_automatic_preselection": true,
  "preselection_fracture_ratio_threshold": 0.3,
  "final_classification_threshold": 0.5,

  "// --- III. Adaptive Threshold Percentiles ---": null,
  "// These determine how the automatic classification works": null,
  "roughness_threshold_percentile": 75,
  "curvature_threshold_percentile": 75,
  "boundary_complexity_threshold_percentile": 75,
  "symmetry_threshold_percentile": 25,
  "planarity_threshold_percentile": 25,

  "// --- IV. Property Weights ---": null,
  "// How much each property contributes to fracture detection": null,
  "fracture_detection_weights": {
    "curvature": 0.3,
    "roughness": 0.3,
    "boundary_complexity": 0.2,
    "symmetry": 0.1,
    "planarity": 0.1
  },

  "// --- V. Legacy Methods (Optional) ---": null,
  "use_adaptive_detection": false,
  "use_combined_approach": true,
  "use_bumpiness_detection": false,
  "bumpiness_threshold": 0.2,
  "use_statistical_analysis": false,

  "// --- VI. Preprocessing Parameters ---": null,
  "voxel_downsample_size": 3.0,
  "fracture_surface_dense_sample_points": 10000,
  "normal_estimation_radius": 14.0,
  "normal_estimation_max_nn": 30,
  "orient_normals_k": 15,
  "fpfh_feature_radius": 10.0,
  "fpfh_feature_max_nn": 100
}
